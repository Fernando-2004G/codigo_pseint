Algoritmo sin_titulo
	//Como usuario de telefonía móvil, necesito consultar tarifas según el plan contratado.
	
	Definir usuario Como Caracter
	Definir opcion Como Entero
	
	Escribir "nombre de usuario"
	leer usuario 
	Escribir "bienvenido ",usuario 
	Escribir "estas son las opciones de tarifas"
	Escribir "1. 50.000"
	Escribir "2. 70.000"
	Escribir "3. 120.000"
	Escribir "elija una opcion de las 3"
	leer opcion
	segun opcion hacer
		
		Opcion 1: 
			escribir "le damos 50gb de navegacion y 300 minutos"
			
		Opcion 2: 
			Escribir "le damos 70gb de navegacion + 300 minnutos y 100 minnutos internacionales"
			
		Opcion 3: 
			Escribir "le damos 100gb de navegacion + minutos ilimitados y 500 minutos internacionales"
			
	FinSegun
	
	
	
	
	
	
FinAlgoritmo
